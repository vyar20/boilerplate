{
  "name": "boilerplate",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo run typecheck",
    "db:push": "turbo run db:push",
    "db:gen": "turbo run db:gen",
    "db:migrate": "turbo run db:migrate",
    "del": "find . -type d \\( -name node_modules -o -name dist \\) -exec rm -rf {} +"
  },
  "dependencies": {
    "hono": "^4.13.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "eslint": "^10.15.0",
    "jiti": "^2.7.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "^6"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.5"
    }
  },
  "workspaces": [
    "apps/*",
    "pkg/*"
  ]
}