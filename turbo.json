{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "db:push": {
      "dependsOn": [
        "^db:push"
      ]
    },
    "db:gen": {
      "dependsOn": [
        "^db:gen"
      ]
    },
    "db:migrate": {
      "dependsOn": [
        "^db:migrate"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}