{
  "compilerOptions": {
    "strict": true,
    "target": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "lib": ["ESNext"],
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"]
  }
}
